{
  "name": "@2fizzle/bip-skills-mcp",
  "version": "1.1.0",
  "description": "MCP server that serves Agent Skills (SKILL.md folders) as tools and resources over stdio or Streamable HTTP. Ships with bip-xsl-hardening for Oracle BI Publisher XSL dashboards.",
  "mcpName": "io.github.2fizzle/bip-skills-mcp",
  "type": "module",
  "bin": {
    "bip-skills-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build && npm run smoke && npm run smoke:http",
    "smoke:http": "node scripts/smoke-http.mjs",
    "start:http": "node -e \"process.env.TRANSPORT='http';import('./dist/index.js')\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-skills",
    "skills",
    "oracle",
    "bi-publisher",
    "xslt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2fizzle/bip-skills-mcp.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^5.3.0",
    "yaml": "^2.6.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
